PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database configuration
MONGODB_URI=mongodb://127.0.0.1:27017/bridge_db
# Set to 'auto' to automatically spin up mongodb-memory-server if local MongoDB is unreachable
USE_MEMORY_DB=auto

# Security & Authentication
JWT_SECRET=bridge_dev_super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# Blockchain configuration
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
CHAIN_ID=1337
